#!/usr/bin/env bash
#
# Example, conservative "update the running app" sequence. Copy this file to
# something like update.sh, fill in the placeholders below, `chmod +x` it,
# and run it by hand (or from an SSH session) whenever you want to deploy a
# new commit. It is NOT installed or scheduled automatically, and this
# session does not run it for you.
#
# It deliberately does NOT:
#   - touch .env
#   - run any destructive database command (no flush/reset/dropdb)
#   - force-push or reset git history
#   - install or (re)start systemd units it doesn't already know about
#
# Stops immediately on any error (set -e) so a failed step never leaves the
# service silently half-updated.

set -euo pipefail

# --- Fill these in for your server, then remove this guard -----------------
echo "Edit deploy/update.sh.example, fill in the paths below, and remove this line." >&2
exit 1

PROJECT_PATH="<PROJECT_PATH>"          # e.g. /home/lifeassistant/lifeos
VENV_PATH="<VENV_PATH>"                # e.g. /home/lifeassistant/lifeos/.venv
GIT_BRANCH="main"                      # branch to deploy
WEB_SERVICE="lifeassistant-web"

# Use the real public URL, not a bare IP/port. Django's ALLOWED_HOSTS
# rejects requests whose Host header doesn't match — curling an IP
# directly (e.g. http://127.0.0.1/ or http://127.0.0.1:8001/) sends that
# IP:port as the Host header and gets a 400, even though the app is
# perfectly healthy; the real domain sends the right Host header
# naturally. This also verifies the whole chain end to end (Gunicorn ->
# reverse proxy -> TLS -> DNS), not just the raw app process.
HEALTH_URL="https://<YOUR_DOMAIN>/health/"

# manage.py defaults to config.settings.development (see manage.py), and .env
# cannot carry this — config/settings/base.py calls load_dotenv() long after
# Django has already resolved the settings module. So every manage.py call
# below has to be told explicitly, or migrate and collectstatic silently run
# against the wrong settings. Getting this wrong is not loud: collectstatic
# under development settings copies files without hashing them or rewriting
# staticfiles.json, and Gunicorn then serves whatever the *old* manifest still
# points at — an old stylesheet, with no error anywhere.
export DJANGO_SETTINGS_MODULE=config.settings.production

# -----------------------------------------------------------------------------

cd "$PROJECT_PATH"

echo "==> Fetching and checking out ${GIT_BRANCH}..."
git fetch origin
git checkout "$GIT_BRANCH"
git pull --ff-only origin "$GIT_BRANCH"

echo "==> Activating virtualenv..."
# shellcheck disable=SC1091
source "${VENV_PATH}/bin/activate"

echo "==> Installing requirements..."
pip install -r requirements.txt

echo "==> Running migrations..."
python manage.py migrate --noinput

echo "==> Collecting static files..."
python manage.py collectstatic --noinput

# Aborts the deploy (set -e) rather than restarting onto a stale manifest.
echo "==> Verifying the static manifest..."
python manage.py check_static_manifest

echo "==> Restarting ${WEB_SERVICE}..."
sudo systemctl restart "${WEB_SERVICE}"

echo "==> Waiting for the app to come back up..."
sleep 2

echo "==> Checking ${HEALTH_URL}..."
if curl -fsS "$HEALTH_URL" | grep -q '"status": "ok"'; then
    echo "==> Deploy succeeded — /health/ reports ok."
else
    echo "==> WARNING: /health/ did not report ok. Check: sudo journalctl -u ${WEB_SERVICE} -n 100" >&2
    exit 1
fi
