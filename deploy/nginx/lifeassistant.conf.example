# Example Nginx site config for the Family Assistant — DEPLOY_ORACLE.md
# "Path A" (dedicated Nginx, this app owns ports 80/443 on its own).
#
# If ports 80/443 are already owned by another app's reverse proxy on this
# box (e.g. a Caddy-in-Docker setup for a different app), do NOT install
# this file — use "Path B" in DEPLOY_ORACLE.md step 13 instead, which adds
# a site entry to that existing proxy and skips Nginx/Certbot entirely. See
# deploy/caddy/lifeassistant-site.Caddyfile.example for that path.
#
# Copy to /etc/nginx/sites-available/lifeassistant.conf, edit the
# placeholders, symlink into sites-enabled, then `nginx -t && systemctl
# reload nginx`. This file is deliberately NOT installed automatically.
#
# Certbot: once this file is in place and Nginx is serving plain HTTP on
# <YOUR_DOMAIN>, run (do not run automatically as part of any deploy
# script):
#     sudo certbot --nginx -d <YOUR_DOMAIN>
# Certbot will edit this file in place to add the `listen 443 ssl;` server
# block and the real certificate paths — the commented-out HTTPS block
# below is only a preview of what it will look like.

# Plain HTTP — Certbot will add a redirect to HTTPS here after issuing a
# certificate. Until then this server block serves the app directly.
server {
    listen 80;
    listen [::]:80;
    server_name <YOUR_DOMAIN>;

    client_max_body_size 5m;

    location = /favicon.ico { access_log off; log_not_found off; }

    location /static/ {
        alias <PROJECT_PATH>/staticfiles/;
        expires 30d;
        access_log off;
    }

    location / {
        proxy_pass http://unix:/run/lifeassistant/gunicorn.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    # Security headers (defence in depth — Django's SecurityMiddleware also
    # sets some of these; harmless to set on both layers).
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
}

# --- After `certbot --nginx` has run, you will have a second server block
# roughly like this (shown here only for reference — do not hand-copy
# certificate paths; let Certbot manage this file itself):
#
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name <YOUR_DOMAIN>;
#
#     ssl_certificate     /etc/letsencrypt/live/<YOUR_DOMAIN>/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/<YOUR_DOMAIN>/privkey.pem;
#     include /etc/letsencrypt/options-ssl-nginx.conf;
#     ssl_dhparam /etc/letsencrypt/ssl-dhparam.pem;
#
#     client_max_body_size 5m;
#
#     location /static/ {
#         alias <PROJECT_PATH>/staticfiles/;
#         expires 30d;
#         access_log off;
#     }
#
#     location / {
#         proxy_pass http://unix:/run/lifeassistant/gunicorn.sock;
#         proxy_set_header Host $host;
#         proxy_set_header X-Real-IP $remote_addr;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_redirect off;
#     }
# }
#
# server {
#     listen 80;
#     listen [::]:80;
#     server_name <YOUR_DOMAIN>;
#     return 301 https://$host$request_uri;
# }
