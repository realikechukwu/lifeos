# --- Django core ---------------------------------------------------------
# Local dev defaults to config.settings.development (see manage.py) and
# does not need DJANGO_SETTINGS_MODULE set at all. In production, set
# DJANGO_SETTINGS_MODULE=config.settings.production as a process
# environment variable (e.g. in the systemd unit's Environment= line) —
# NOT in this file, since it has to be known before .env is even loaded.
DJANGO_SETTINGS_MODULE=config.settings.production

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS / security (production only) -----------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_HSTS_PRELOAD=False

APP_BASE_URL=

# --- Gunicorn ---------------------------------------------------------
# Only needed if this app sits behind an *existing* shared reverse proxy
# (e.g. another app's Caddy-in-Docker setup already owns ports 80/443 on
# this box — DEPLOY_ORACLE.md "Path B"). Leave unset for a dedicated Nginx
# setup ("Path A"), where Gunicorn uses a Unix socket instead.
#
# Must be 0.0.0.0:<port>, NOT 127.0.0.1:<port> — traffic from the proxy
# container arrives via the Docker bridge interface, not loopback, so a
# loopback-only bind will never see it. Binding 0.0.0.0 does expose this
# port on every host interface, including the public one, so it MUST be
# paired with a host firewall rule restricting it to the proxy's own
# Docker subnet — see DEPLOY_ORACLE.md step 13, Path B, item 5b. Never add
# this port to your cloud provider's public ingress rules.
GUNICORN_BIND=

# --- Database ---------------------------------------------------------
# Unset -> SQLite (db.sqlite3) locally. Set to a Supabase Postgres
# connection string for production. See DEPLOY_ORACLE.md step 7 for the
# transaction-pooler-vs-direct-connection distinction.
DATABASE_URL=

APP_TIMEZONE=Europe/London
APP_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRETS_FILE=
GOOGLE_CALENDAR_ID=
GOOGLE_ASSISTANT_EMAIL=lifeofchukwudi@gmail.com

AUTHORISED_EMAIL_IKE=
AUTHORISED_EMAIL_WIFE=

GMAIL_PROCESSED_LABEL=LifeAssistant/Processed
GMAIL_PENDING_LABEL=LifeAssistant/Pending
GMAIL_FAILED_LABEL=LifeAssistant/Failed
GMAIL_UNAUTHORISED_LABEL=LifeAssistant/Unauthorised

AUTOMATIC_ACTION_CONFIDENCE_THRESHOLD=0.85

# --- Logging ---------------------------------------------------------
LOG_LEVEL=INFO
