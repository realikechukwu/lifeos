[Unit]
Description=Family Assistant — sync Patchwork work shifts (triggered by lifeassistant-patchwork-calendar.timer)
After=network.target

[Service]
Type=oneshot
User=<LINUX_USERNAME>
Group=<LINUX_USERNAME>
WorkingDirectory=<PROJECT_PATH>
EnvironmentFile=<ENV_FILE_PATH>
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=<VENV_PATH>/bin/python manage.py sync_patchwork_calendar

# The Patchwork endpoint has a short timeout in application code; this is a
# final safety cap so an unavailable provider cannot block future runs.
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true
