[Unit]
Description=Family Assistant — sync Patchwork work shifts (triggered by lifeassistant-patchwork-calendar.timer)
After=network.target

[Service]
Type=oneshot
User=<LINUX_USERNAME>
Group=<LINUX_USERNAME>
WorkingDirectory=<PROJECT_PATH>
EnvironmentFile=<ENV_FILE_PATH>
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=<VENV_PATH>/bin/python manage.py sync_patchwork_calendar

# The first labelled/de-duplicated sync may update hundreds of existing
# Google events. Keep a bounded but generous cap; later runs are incremental.
TimeoutStartSec=600

NoNewPrivileges=true
PrivateTmp=true
